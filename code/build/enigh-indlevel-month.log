. *************************************************
. ************* Years of Study *********************
. *************************************************
. 
. cap program drop build_years_of_study

. program define build_years_of_study
  1.     *** Derives years_of_study (0-25) from nivelaprob and gradoaprob.
.     *** Mexico education levels:
.     ***   niv 0,1 = none/preschool       -> 0
.     ***   niv 2   = primary (1-6)        -> grad
.     ***   niv 3   = secondary (1-3)      -> 6+grad
.     ***   niv 4   = upper secondary (1-3)-> 9+grad
.     ***   niv 5,6 = post-secondary tech  -> 12+grad capped 5
.     ***   niv 7   = bachelor's            -> 12+grad capped 5
.     ***   niv 8   = master's              -> 17+grad
.     ***   niv 9   = doctorate             -> 20+grad
.     cap destring nivelaprob, replace
  2.     cap destring gradoaprob, replace
  3.     cap drop years_of_study
  4.     gen years_of_study = .
  5.     replace years_of_study = 0                if inlist(nivelaprob, 0, 1)
  6.     replace years_of_study = min(gradoaprob, 6)         if nivelaprob == 2
  7.     replace years_of_study = 6  + min(gradoaprob, 3)    if nivelaprob == 3
  8.     replace years_of_study = 9  + min(gradoaprob, 3)    if nivelaprob == 4
  9.     replace years_of_study = 12 + min(gradoaprob, 5)    if inlist(nivelaprob, 5, 6, 7)
 10.     replace years_of_study = 17 + min(gradoaprob, 3)    if nivelaprob == 8
 11.     replace years_of_study = 20 + min(gradoaprob, 5)    if nivelaprob == 9
 12.     label variable years_of_study "years of completed schooling"
 13. end

