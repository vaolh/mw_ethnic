. *************************************************
. *********** Build per-year tempfiles *************
. *************************************************
. 
. local years 2016 2018 2020 2022 2024

. local tempfiles ""

. 
. foreach year of local years {
  2. 
.     display _n "Processing ENIGH `year' …"
  3. 
.     *** Poblacion (individual demographics — keep ALL available columns).
.     *** new_id is preserved as folioviv+foliohog+numren so downstream tables
.     *** can be merged in via this key. Variable names drift between waves
.     *** (especially the disability block in 2024 which uses disc_ver/disc_oir
.     *** etc. instead of disc1-disc7) — we destring whatever is present and
.     *** rely on apply_all_labels to attach value labels at the end.
.     use "../../data/source/enigh/poblacion`year'.dta", clear
  4. 
.     *** Harmonize 2024 disability aliases back to canonical disc1-disc7 if
.     *** the wave used the new naming. Map (best-effort): caminar → disc1,
.     *** ver → disc2, hablar → disc3, oir → disc4, vestirse → disc5,
.     *** aprender → disc6, mental → disc7. Older waves with disc1-disc7
.     *** keep their values.
.     cap rename disc_camin   disc1
  5.     cap rename disc_ver     disc2
  6.     cap rename disc_habla   disc3
  7.     cap rename disc_oir     disc4
  8.     cap rename disc_vest    disc5
  9.     cap rename disc_apren   disc6
 10.     cap rename disc_acti    disc7
 11. 
.     *** Selectively destring the helper numerics needed by the canonical
.     *** recodes below. The remaining string columns are bulk-destringed
.     *** AFTER the recodes (which read raw "1"/"2" strings).
.     cap destring sexo edad parentesco nivelaprob gradoaprob hor_1, replace
 12. 
.     *** Canonical recodes
.     gen byte gender             = .
 13.     replace gender              = 1 if sexo == 1
 14.     replace gender              = 0 if sexo == 2
 15.     label variable gender       "1=Male, 0=Female"
 16. 
.     gen byte etnia_bin          = .
 17.     replace etnia_bin           = 1 if etnia == "1"
 18.     replace etnia_bin           = 0 if etnia == "2"
 19.     drop etnia
 20.     rename etnia_bin etnia
 21.     label variable etnia        "indigenous self-identification (1=yes)"
 22. 
.     gen byte indspeaker         = .
 23.     replace indspeaker          = 1 if hablaind == "1"
 24.     replace indspeaker          = 0 if hablaind == "2"
 25.     label variable indspeaker   "speaks indigenous language (HLI, 1=yes)"
 26. 
.     gen byte indund             = .
 27.     replace indund              = 1 if comprenind == "1"
 28.     replace indund              = 0 if comprenind == "2"
 29.     label variable indund       "understands indigenous language (1=yes)"
 30. 
.     gen byte school_attendance  = .
 31.     replace school_attendance   = 1 if asis_esc == "1"
 32.     replace school_attendance   = 0 if asis_esc == "2"
 33.     label variable school_attendance "currently attending school (1=yes)"
 34. 
.     gen byte motherhome         = .
 35.     replace motherhome          = 1 if madre_hog == "1"
 36.     replace motherhome          = 0 if madre_hog == "2"
 37.     label variable motherhome   "mother lives in HH (1=yes)"
 38. 
.     gen byte fatherhome         = .
 39.     replace fatherhome          = 1 if padre_hog == "1"
 40.     replace fatherhome          = 0 if padre_hog == "2"
 41.     label variable fatherhome   "father lives in HH (1=yes)"
 42. 
.     gen byte employed           = .
 43.     replace employed            = 1 if trabajo_mp == "1"
 44.     replace employed            = 0 if trabajo_mp == "2"
 45.     label variable employed     "employed in reference month (1=yes)"
 46. 
.     rename hor_1 hoursworked
 47.     label variable hoursworked  "weekly hours worked (poblacion)"
 48. 
.     build_years_of_study
 49. 
.     *** Now bulk-destring all remaining string columns (they were kept as
.     *** strings until the canonical recodes finished reading "1"/"2" codes).
.     quietly: ds, has(type string)
 50.     foreach v in `r(varlist)' {
 51.         if !inlist("`v'", "folioviv", "foliohog", "numren") {
 52.             cap destring `v', replace
 53.         }
 54.     }
 55. 
.     *** Keep all the raw poblacion columns (nivel/grado/health/time-use/
.     *** social-network/fertility/marital/disability/etc.) — they are preserved
.     *** alongside the canonical recodes (gender, etnia, indspeaker, indund,
.     *** school_attendance, motherhome, fatherhome, employed, hoursworked,
.     *** years_of_study). apply_all_labels will attach value labels at save.
.     tempfile pop_`year'
 56.     save `pop_`year''
 57. 
.     *** Concentradohogar (HH expansion weight, ubica_geo, smg)
.     use "../../data/source/enigh/concentradohogar`year'.dta", clear
 58.     cap confirm string variable ubica_geo
 59.     if _rc {
 60.         tostring ubica_geo, replace
 61.     }
 62.     keep folioviv ubica_geo factor smg
 63.     duplicates drop folioviv, force
 64.     clean_ubica_geo `year'
 65.     tempfile hog_`year'
 66.     save `hog_`year''
 67. 
.     *** Viviendas (housing + survey design)
.     *** Variable names drift across years (e.g., 2024 renames disp_agua →
.     *** agua_ent, combustible → combus, etc.). Keep only columns that exist
.     *** in this year's file, then harmonize aliases below.
.     use "../../data/source/enigh/viviendas`year'.dta", clear
 68.     *** Harmonize 2024+ aliases back to canonical names.
.     cap rename agua_ent     disp_agua
 69.     cap rename combus       combustible
 70.     cap rename medid_luz    medidor_luz
 71.     cap rename focos        focos_inca
 72.     local viv_all folioviv tipo_viv mat_pared mat_techos mat_pisos antiguedad ///
>                   cuart_dorm num_cuarto disp_agua dotac_agua excusado disp_elect ///
>                   combustible eli_basura tenencia renta estim_pago pago_viv ///
>                   tot_resid tot_hom tot_muj tot_hog tam_loc est_socio est_dis upm
 73.     local viv_keep ""
 74.     foreach v of local viv_all {
 75.         cap confirm variable `v'
 76.         if _rc == 0 local viv_keep "`viv_keep' `v'"
 77.     }
 78.     keep `viv_keep'
 79.     duplicates drop folioviv, force
 80.     foreach v of local viv_keep {
 81.         if "`v'" != "folioviv" cap destring `v', replace
 82.     }
 83.     *** Add any missing canonical columns as . so the panel stacks cleanly.
.     foreach v of local viv_all {
 84.         cap confirm variable `v'
 85.         if _rc gen double `v' = .
 86.     }
 87.     tempfile viv_`year'
 88.     save `viv_`year''
 89. 
.     *** Trabajos (jobs and benefits)
.     use "../../data/source/enigh/trabajos`year'.dta", clear
 90.     rename_benefits `year'
 91.     *** Some years have tipo_trab/ocupa, others do not — drop if present
.     cap drop tipo_trab ocupa
 92.     *** Collapse so each (HH × person × job) has one row.
.     collapse (sum) htrab, by(folioviv foliohog numren id_trabajo ///
>         scian sinco subor indep personal pago contrato tipocontr ///
>         incapacidad aguinaldo vacaciones utilidades credito_vivienda ///
>         guarderias cuidados_parentales sar_afore seguro_vida prestamos ///
>         prima_vacacional becas comedor fonacot despensa servicios_publicos ///
>         pension_invalidez pension_familia otras_prestaciones sin_prestaciones)
 93.     *** Reshape wide so we have *1 (main job) and *2 (secondary job) columns.
.     reshape wide htrab scian sinco subor indep personal pago contrato tipocontr ///
>         incapacidad aguinaldo vacaciones utilidades credito_vivienda ///
>         guarderias cuidados_parentales sar_afore seguro_vida prestamos ///
>         prima_vacacional becas comedor fonacot despensa servicios_publicos ///
>         pension_invalidez pension_familia otras_prestaciones sin_prestaciones, ///
>         i(folioviv foliohog numren) j(id_trabajo) string
 94.     *** Industry codes from SCIAN
.     gen ind1 = real(substr(scian1, 1, 2))
 95.     gen ind2 = real(substr(scian2, 1, 2))
 96.     label_scian
 97.     rename htrab1 hours1
 98.     rename htrab2 hours2
 99.     label variable hours1 "weekly hours – main job"
100.     label variable hours2 "weekly hours – secondary job"
101.     *** Recode benefits to 0/1 binaries (single source of truth in helper)
.     recode_benefit_indicators
102.     *** Subordinate / independent / personnel / paid / contract → 0/1
.     foreach base in subor indep personal pago contrato tipocontr {
103.         foreach j in 1 2 {
104.             cap destring `base'`j', replace
105.             cap recode `base'`j' (1=1)(2=0)(3=0)(else=0)
106.         }
107.     }
108.     tempfile trab_`year'
109.     save `trab_`year''
110. 
.     *** Gastospersona (personal expenditure aggregates)
.     use "../../data/source/enigh/gastospersona`year'.dta", clear
111.     collapse (sum) gasto_tri gas_nm_tri, by(folioviv foliohog numren)
112.     rename gasto_tri  gaspers_tri
113.     rename gas_nm_tri gaspers_ntri
114.     label variable gaspers_tri  "trimestral monetary expenditure (person)"
115.     label variable gaspers_ntri "trimestral non-monetary expenditure (person)"
116.     tempfile gpers_`year'
117.     save `gpers_`year''
118. 
.     *** Ingresos (income panel) — reshape to person × month
.     use "../../data/source/enigh/ingresos`year'.dta", clear
119.     classify_clave
120.     drop if missing(clave_group) | clave_group == ""
121.     *** ENIGH ingresos has 6 (slot, amount, month) tuples per record:
.     *** ing_1…ing_6 are amounts; mes_1…mes_6 are calendar months ("01"–"12").
.     *** Reshape so each row is one (person × clave × slot).
.     reshape long ing_ mes_, i(folioviv foliohog numren clave) j(slot)
122.     *** Normalize the month string and drop empty slots.
.     cap confirm string variable mes_
123.     if _rc {
124.         tostring mes_, replace force
125.     }
126.     replace mes_ = trim(mes_)
127.     drop if missing(mes_) | mes_ == ""
128.     gen byte month = real(mes_)
129.     drop if missing(month) | month < 1 | month > 12
130.     *** Aggregate to (person × clave_group × calendar-month).
.     collapse (sum) ing_nom = ing_, ///
>              by(folioviv foliohog numren clave_group month)
131.     *** Pivot wide so each clave_group becomes its own nominal column.
.     reshape wide ing_nom, ///
>              i(folioviv foliohog numren month) j(clave_group) string
132.     *** Standardize column names: ing_nom<group> → ing_<group>_nom.
.     foreach grp in wages non_wage_income gov_transfers rentas fin_capital ///
>                    negocio ventas other {
133.         cap rename ing_nom`grp' ing_`grp'_nom
134.         cap confirm variable ing_`grp'_nom
135.         if _rc {
136.             gen double ing_`grp'_nom = .
137.         }
138.         replace ing_`grp'_nom = 0 if missing(ing_`grp'_nom)
139.         label variable ing_`grp'_nom "nominal monthly `grp' income (pesos)"
140.     }
141.     tempfile inc_`year'
142.     save `inc_`year''
143. 
.     *** Merge all per-year pieces
.     use `inc_`year'', clear
144.     merge m:1 folioviv foliohog numren using `pop_`year''
145.     drop _merge
146.     merge m:1 folioviv foliohog numren using `trab_`year''
147.     drop _merge
148.     merge m:1 folioviv foliohog numren using `gpers_`year''
149.     drop _merge
150.     merge m:1 folioviv using `viv_`year''
151.     drop _merge
152.     merge m:1 folioviv using `hog_`year''
153.     drop _merge
154. 
.     gen year = `year'
155.     order folioviv foliohog numren year month
156. 
.     tempfile yr_`year'
157.     save `yr_`year''
158.     local tempfiles "`tempfiles' `yr_`year''"
159. }

