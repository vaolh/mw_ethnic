. *************************************************
. **************** HH type from hogares ************
. *************************************************
. 
. tempfile hh_class_all

. local first_iter = 1

. foreach yr of local YEARS {
  2.     use "../../data/source/enigh/hogares`yr'.dta", clear
  3.     rename _all, lower
  4.     cap confirm variable clase_hog
  5.     if _rc continue
  6.     keep folioviv foliohog clase_hog
  7.     duplicates drop folioviv foliohog, force
  8.     cap destring clase_hog, replace
  9.     gen year = `yr'
 10.     if `first_iter' {
 11.         save `hh_class_all', replace
 12.         local first_iter = 0
 13.     }
 14.     else {
 15.         append using `hh_class_all', force
 16.         save `hh_class_all', replace
 17.     }
 18. }
  (all newnames==oldnames)
  (all newnames==oldnames)
  (all newnames==oldnames)
  (all newnames==oldnames)
  (all newnames==oldnames)

. 
. use `hh_panel_v3', clear

. capture confirm file `hh_class_all'

. if _rc == 0 {
.     merge 1:1 folioviv foliohog year using `hh_class_all'
.     drop if _merge == 2
.     drop _merge
. }

