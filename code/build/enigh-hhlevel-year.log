. *************************************************
. **************** HH head from poblacion **********
. *************************************************
. 
. tempfile hh_head_all

. local first_iter = 1

. foreach yr of local YEARS {
  2.     use "../../data/source/enigh/poblacion`yr'.dta", clear
  3.     rename _all, lower
  4.     keep folioviv foliohog numren parentesco sexo edad etnia hablaind ///
>          nivelaprob gradoaprob trabajo_mp
  5.     cap destring parentesco sexo edad nivelaprob gradoaprob, replace
  6.     keep if parentesco == 101
  7.     duplicates drop folioviv foliohog, force
  8.     gen byte head_age      = edad
  9.     gen byte head_sex      = (sexo == 1)
 10.     gen byte head_etnia    = (etnia == "1")
 11.     gen byte head_indspeaker = (hablaind == "1")
 12.     gen byte head_employed = (trabajo_mp == "1")
 13.     build_years_of_study
 14.     rename years_of_study head_educ
 15.     keep folioviv foliohog head_age head_sex head_etnia head_indspeaker ///
>          head_employed head_educ
 16.     gen year = `yr'
 17.     if `first_iter' {
 18.         save `hh_head_all', replace
 19.         local first_iter = 0
 20.     }
 21.     else {
 22.         append using `hh_head_all', force
 23.         save `hh_head_all', replace
 24.     }
 25. }
  (all newnames==oldnames)
