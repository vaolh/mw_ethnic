. 
. tempfile hh_exp_all

. local first_iter = 1

. foreach yr of local YEARS {
  2.     tempfile _hh_yr
  3.     aggregate_gastos_hh_year `yr' "`defl_tf'" "`_hh_yr'"
  4.     if `first_iter' {
  5.         use "`_hh_yr'", clear
  6.         save `hh_exp_all', replace
  7.         local first_iter = 0
  8.     }
  9.     else {
 10.         append using "`_hh_yr'", force
 11.         save `hh_exp_all', replace
 12.     }
 13. }
