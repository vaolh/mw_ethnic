. *************************************************
. *********** Comprehensive Value Labels ***********
. *************************************************
. 
. *** apply_all_labels: defines and applies value labels for every categorical
. *** variable across the four cleaned datasets. Idempotent — safe to call more
. *** than once. Wraps each `label values` in `cap` so missing variables are
. *** silently skipped. Run AFTER all destring + recoding is done, just before
. *** save.
. 
. cap program drop apply_all_labels

. program define apply_all_labels
  1. 
.     *** Yes/No (1/0) base label set, applied to a known list of binary flags.
.     label define yesno_lbl 0 "No" 1 "Yes", replace
  2.     foreach v in employed indspeaker indund etnia school_attendance ///
>                  motherhome fatherhome zlfn post treat_post informal ///
>                  gov_sp public profesional hablaesp alfabetism segsoc ///
>                  segpop atemed prob_sal aten_sal diabetes pres_alta peso ///
>                  hijos_sob pareja_hog has_wage has_lab has_negocio ///
>                  head_etnia head_indspeaker head_employed {
  3.         cap label values `v' yesno_lbl
  4.     }
  5.     *** Apply Yes/No to all benefit *1 / *2 columns.
.     foreach b in incapacidad aguinaldo vacaciones utilidades credito_vivienda ///
>                  guarderias cuidados_parentales sar_afore seguro_vida prestamos ///
>                  prima_vacacional becas comedor fonacot despensa servicios_publicos ///
>                  pension_invalidez pension_familia otras_prestaciones sin_prestaciones ///
>                  subor indep personal pago contrato {
  6.         foreach j in 1 2 {
  7.             cap label values `b'`j' yesno_lbl
  8.         }
  9.     }
 10.     *** Disability dummies disc2-disc7 (disc1 has its own kind label below).
.     foreach j in 2 3 4 5 6 7 {
 11.         cap label values disc`j' yesno_lbl
 12.     }
 13.     *** servmed_*, inscr_*, inst_* health-presence dummies, others.
.     forvalues i = 1/11 {
 14.         cap label values servmed_`i' yesno_lbl
 15.         cap label values inscr_`i'   yesno_lbl
 16.     }
 17.     cap label values cocina      yesno_lbl
 18.     cap label values cocina_dor  yesno_lbl
 19.     cap label values excusado    yesno_lbl
 20.     cap label values uso_compar  yesno_lbl
 21.     cap label values biodigest   yesno_lbl
 22.     cap label values lavadero    yesno_lbl
 23.     cap label values fregadero   yesno_lbl
 24.     cap label values regadera    yesno_lbl
 25.     cap label values tinaco_azo  yesno_lbl
 26.     cap label values cisterna    yesno_lbl
 27.     cap label values pileta      yesno_lbl
 28.     cap label values calent_sol  yesno_lbl
 29.     cap label values calent_gas  yesno_lbl
 30.     cap label values medidor_luz yesno_lbl
 31.     cap label values bomba_agua  yesno_lbl
 32.     cap label values tanque_gas  yesno_lbl
 33.     cap label values aire_acond  yesno_lbl
 34.     cap label values calefacc    yesno_lbl
 35.     cap label values estufa_chi  yesno_lbl
 36.     cap label values pago_mesp   yesno_lbl
 37.     cap label values viv_usada   yesno_lbl
 38.     cap label values antigua_ne  yesno_lbl
 39.     cap label values tiene_b     yesno_lbl
 40.     cap label values tiene_c     yesno_lbl
 41. 
.     *** Gender / sex (1=Male, 0=Female).
.     label define gender_lbl 0 "Female" 1 "Male", replace
 42.     cap label values gender   gender_lbl
 43.     cap label values head_sex gender_lbl
 44. 
.     *** Female (1=Female).
.     label define female_lbl 0 "Male" 1 "Female", replace
 45.     cap label values female female_lbl
 46. 
.     *** Treatment / time.
.     label define zlfn_lbl   0 "Non-ZLFN" 1 "ZLFN", replace
 47.     cap label values zlfn       zlfn_lbl
 48.     label define post_lbl   0 "Pre (≤2018)" 1 "Post (>2018)", replace
 49.     cap label values post       post_lbl
 50. 
.     *** Parentesco (relationship to head).
.     label define parentesco_lbl ///
>         101 "Jefe(a) del hogar" ///
>         201 "Esposo(a) o compañero(a)" ///
>         301 "Hijo(a)" 302 "Hijastro(a)" ///
>         401 "Nuero o nuera" ///
>         501 "Nieto(a)" ///
>         601 "Padre o madre" 602 "Suegro(a)" ///
>         701 "Hermano(a)" 702 "Cuñado(a)" ///
>         801 "Otro parentesco" ///
>         901 "No parentesco" ///
>         999 "No especificado", replace
 51.     cap label values parentesco parentesco_lbl
 52. 
.     *** Marital status (edo_conyug).
.     label define edo_conyug_lbl ///
>         1 "Unión libre" 2 "Casado(a)" 3 "Separado(a)" ///
>         4 "Divorciado(a)" 5 "Viudo(a)" 6 "Soltero(a)", replace
 53.     cap label values edo_conyug edo_conyug_lbl
 54. 
.     *** Education currently attending (nivel) and grade (grado).
.     label define nivel_lbl ///
>         1 "Preescolar o kinder" 2 "Primaria" 3 "Secundaria" ///
>         4 "Preparatoria o bachillerato" 5 "Normal básica" ///
>         6 "Carrera técnica o comercial" 7 "Profesional" ///
>         8 "Maestría" 9 "Doctorado", replace
 55.     cap label values nivel nivel_lbl
 56.     label define grado_lbl ///
>         1 "Primer año" 2 "Segundo año" 3 "Tercer año" ///
>         4 "Cuarto año" 5 "Quinto año" 6 "Sexto año", replace
 57.     cap label values grado grado_lbl
