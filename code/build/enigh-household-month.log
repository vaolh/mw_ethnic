. *************************************************
. ************** ZLFN Municipalities ***************
. *************************************************
. 
. *** 40 municipalities in the Zona Libre de la Frontera Norte (ZLFN)
. *** as defined by the Decreto del Estímulo Fiscal de la Frontera Norte (2018).
. *** Codes are 5-digit (state + municipality).
. global zlfn_munis ///
>     "02001 02002 02003 02004 02005 " ///
>     "05002 05012 05013 05014 05022 05023 05025 05038 " ///
>     "08005 08015 08028 08035 08037 08042 08052 08053 " ///
>     "19005 " ///
>     "26002 26004 26017 26019 26039 26043 26048 26055 26059 26060 26070 " ///
>     "28007 28014 28015 28022 28024 28025 28027 28032 28033 28040"

. 
. cap program drop apply_zlfn

. program define apply_zlfn
  1.     *** Generates zlfn (1/0) from ubica_geo (string, 5-digit).
.     *** Assumes ubica_geo has been cleaned to 5-digit form.
.     syntax , [Ugeo(string)]
  2.     if "`ugeo'" == "" local ugeo "ubica_geo"
  3.     cap drop zlfn
  4.     gen byte zlfn = 0
  5.     label variable zlfn "ZLFN treatment municipality (1=yes)"
  6.     foreach m of global zlfn_munis {
  7.         replace zlfn = 1 if `ugeo' == "`m'"
  8.     }
  9. end

. 
. *************************************************
. **************** ubica_geo Clean *****************
. *************************************************
. 
. cap program drop clean_ubica_geo

. program define clean_ubica_geo
  1.     *** Cleans ubica_geo to consistent 5-digit string (state+muni).
.     *** 2016 ENIGH stores 9-digit codes (state+muni+locality);
.     *** later years already store 5-digit. Truncate if needed.
.     args yr
  2.     cap confirm string variable ubica_geo
  3.     if _rc {
  4.         tostring ubica_geo, replace
  5.     }
  6.     *** Truncate any code longer than 5 digits to first 5 chars.
.     replace ubica_geo = substr(ubica_geo, 1, 5) if length(ubica_geo) > 5
  7.     *** Pad shorter codes with leading zeros (defensive).
.     replace ubica_geo = "0" + ubica_geo if length(ubica_geo) == 4
  8. end

. 
. *************************************************
. *************** State / Region *******************
. *************************************************
. 
. cap program drop apply_state_region

. program define apply_state_region
  1.     *** Generates state, ent_name, reg_num, reg_name, macro_num, macro_name
.     *** from ubica_geo (string, 5-digit, first 2 chars = state).
.     cap drop state
  2.     gen state = real(substr(ubica_geo, 1, 2))
  3.     label variable state "state code (2-digit)"
  4. 
.     label define _states ///
>         1 "Aguascalientes" 2 "Baja California" 3 "Baja California Sur" ///
>         4 "Campeche" 5 "Coahuila" 6 "Colima" 7 "Chiapas" 8 "Chihuahua" ///
>         9 "Ciudad de México" 10 "Durango" 11 "Guanajuato" 12 "Guerrero" ///
>         13 "Hidalgo" 14 "Jalisco" 15 "México" 16 "Michoacán" 17 "Morelos" ///
>         18 "Nayarit" 19 "Nuevo León" 20 "Oaxaca" 21 "Puebla" 22 "Querétaro" ///
>         23 "Quintana Roo" 24 "San Luis Potosí" 25 "Sinaloa" 26 "Sonora" ///
>         27 "Tabasco" 28 "Tamaulipas" 29 "Tlaxcala" 30 "Veracruz" ///
>         31 "Yucatán" 32 "Zacatecas", replace
  5.     label values state _states
  6. 
.     *** Persist as a string column too (so the variable list matches R parity)
.     cap drop ent_name
  7.     decode state, gen(ent_name)
  8. 
.     cap drop reg_num
  9.     gen byte reg_num = .
 10.     replace reg_num = 1 if inlist(state, 26, 25, 2, 3, 18)
 11.     replace reg_num = 2 if inlist(state, 5, 8, 10, 32, 24)
 12.     replace reg_num = 3 if inlist(state, 28, 19)
 13.     replace reg_num = 4 if inlist(state, 1, 14, 11, 6, 16)
 14.     replace reg_num = 5 if inlist(state, 22, 15, 9, 13, 17, 29, 21)
 15.     replace reg_num = 6 if inlist(state, 12, 20, 7)
 16.     replace reg_num = 7 if inlist(state, 27, 30)
 17.     replace reg_num = 8 if inlist(state, 4, 23, 31)
 18.     label variable reg_num "region (1-8)"
 19. 
.     label define _regs ///
>         1 "Northwest" 2 "North" 3 "Northeast" 4 "Center-West" ///
>         5 "Center-East" 6 "South" 7 "East" 8 "Peninsula", replace
 20.     label values reg_num _regs
 21.     cap drop reg_name
 22.     decode reg_num, gen(reg_name)
 23. 
.     cap drop macro_num
 24.     gen byte macro_num = .
 25.     replace macro_num = 1 if inlist(reg_num, 1, 2, 3)
 26.     replace macro_num = 2 if inlist(reg_num, 4, 5)
 27.     replace macro_num = 3 if inlist(reg_num, 6)
 28.     replace macro_num = 4 if inlist(reg_num, 7, 8)
 29.     label variable macro_num "macro region (1-4)"
 30. 
.     label define _macros ///
>         1 "Northern" 2 "Central" 3 "South" 4 "Eastern", replace
 31.     label values macro_num _macros
 32.     cap drop macro_name
 33.     decode macro_num, gen(macro_name)
 34. end

