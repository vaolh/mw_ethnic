. 
. foreach year of local years {
  2. 
.     display _n "Processing ENIGH `year' …"
  3. 
.     *** ---- Poblacion (individual demographics) -------------------
.     use "../../data/source/enigh/poblacion`year'.dta", clear
  4.     keep folioviv foliohog numren ///
>         sexo edad parentesco ///
>         hablaind comprenind etnia ///
>         madre_hog padre_hog asis_esc ///
>         nivelaprob gradoaprob ///
>         hor_1 trabajo_mp num_trabaj
  5.     cap destring sexo, replace
  6.     cap destring edad, replace
  7.     cap destring parentesco, replace
  8.     cap destring nivelaprob, replace
  9.     cap destring gradoaprob, replace
 10.     cap destring hor_1, replace
 11. 
.     *** Canonical recodes
.     gen byte gender             = .
 12.     replace gender              = 1 if sexo == 1
 13.     replace gender              = 0 if sexo == 2
 14.     label variable gender       "1=Male, 0=Female"
 15. 
.     gen byte etnia_bin          = .
 16.     replace etnia_bin           = 1 if etnia == "1"
 17.     replace etnia_bin           = 0 if etnia == "2"
 18.     drop etnia
 19.     rename etnia_bin etnia
 20.     label variable etnia        "indigenous self-identification (1=yes)"
 21. 
.     gen byte indspeaker         = .
 22.     replace indspeaker          = 1 if hablaind == "1"
 23.     replace indspeaker          = 0 if hablaind == "2"
 24.     label variable indspeaker   "speaks indigenous language (HLI, 1=yes)"
 25. 
.     gen byte indund             = .
 26.     replace indund              = 1 if comprenind == "1"
 27.     replace indund              = 0 if comprenind == "2"
 28.     label variable indund       "understands indigenous language (1=yes)"
 29. 
.     gen byte school_attendance  = .
 30.     replace school_attendance   = 1 if asis_esc == "1"
 31.     replace school_attendance   = 0 if asis_esc == "2"
 32.     label variable school_attendance "currently attending school (1=yes)"
 33. 
.     gen byte motherhome         = .
 34.     replace motherhome          = 1 if madre_hog == "1"
 35.     replace motherhome          = 0 if madre_hog == "2"
 36.     label variable motherhome   "mother lives in HH (1=yes)"
 37. 
.     gen byte fatherhome         = .
 38.     replace fatherhome          = 1 if padre_hog == "1"
 39.     replace fatherhome          = 0 if padre_hog == "2"
 40.     label variable fatherhome   "father lives in HH (1=yes)"
 41. 
.     gen byte employed           = .
 42.     replace employed            = 1 if trabajo_mp == "1"
 43.     replace employed            = 0 if trabajo_mp == "2"
 44.     label variable employed     "employed in reference month (1=yes)"
 45. 
.     rename hor_1 hoursworked
 46.     label variable hoursworked  "weekly hours worked (poblacion)"
 47. 
.     build_years_of_study
 48. 
.     drop sexo hablaind comprenind asis_esc madre_hog padre_hog ///
>          trabajo_mp nivelaprob gradoaprob
 49. 
.     tempfile pop_`year'
 50.     save `pop_`year''
 51. 
.     *** ---- Concentradohogar (HH expansion weight, ubica_geo, smg) ---
.     use "../../data/source/enigh/concentradohogar`year'.dta", clear
 52.     cap confirm string variable ubica_geo
 53.     if _rc {
 54.         tostring ubica_geo, replace
 55.     }
 56.     keep folioviv ubica_geo factor smg
 57.     duplicates drop folioviv, force
 58.     clean_ubica_geo `year'
 59.     tempfile hog_`year'
 60.     save `hog_`year''
 61. 
.     *** ---- Viviendas (housing + survey design) ----------------------
.     *** Variable names drift across years (e.g., 2024 renames disp_agua →
.     *** agua_ent, combustible → combus, etc.). Keep only columns that exist
.     *** in this year's file, then harmonize aliases below.
.     use "../../data/source/enigh/viviendas`year'.dta", clear
 62.     *** Harmonize 2024+ aliases back to canonical names.
.     cap rename agua_ent     disp_agua
 63.     cap rename combus       combustible
 64.     cap rename medid_luz    medidor_luz
 65.     cap rename focos        focos_inca
 66.     local viv_all folioviv tipo_viv mat_pared mat_techos mat_pisos antiguedad ///
>                   cuart_dorm num_cuarto disp_agua dotac_agua excusado disp_elect ///
>                   combustible eli_basura tenencia renta estim_pago pago_viv ///
>                   tot_resid tot_hom tot_muj tot_hog tam_loc est_socio est_dis upm
 67.     local viv_keep ""
 68.     foreach v of local viv_all {
 69.         cap confirm variable `v'
 70.         if _rc == 0 local viv_keep "`viv_keep' `v'"
 71.     }
 72.     keep `viv_keep'
 73.     duplicates drop folioviv, force
 74.     foreach v of local viv_keep {
 75.         if "`v'" != "folioviv" cap destring `v', replace
 76.     }
 77.     *** Add any missing canonical columns as . so the panel stacks cleanly.
.     foreach v of local viv_all {
 78.         cap confirm variable `v'
 79.         if _rc gen double `v' = .
 80.     }
 81.     tempfile viv_`year'
 82.     save `viv_`year''
 83. 
.     *** ---- Trabajos (jobs and benefits) ----------------------------
.     use "../../data/source/enigh/trabajos`year'.dta", clear
 84.     rename_benefits `year'
 85.     *** Some years have tipo_trab/ocupa, others do not — drop if present
.     cap drop tipo_trab ocupa
 86.     *** Collapse so each (HH × person × job) has one row.
.     collapse (sum) htrab, by(folioviv foliohog numren id_trabajo ///
>         scian sinco subor indep personal pago contrato tipocontr ///
>         incapacidad aguinaldo vacaciones utilidades credito_vivienda ///
>         guarderias cuidados_parentales sar_afore seguro_vida prestamos ///
>         prima_vacacional becas comedor fonacot despensa servicios_publicos ///
>         pension_invalidez pension_familia otras_prestaciones sin_prestaciones)
 87.     *** Reshape wide so we have *1 (main job) and *2 (secondary job) columns.
.     reshape wide htrab scian sinco subor indep personal pago contrato tipocontr ///
>         incapacidad aguinaldo vacaciones utilidades credito_vivienda ///
>         guarderias cuidados_parentales sar_afore seguro_vida prestamos ///
>         prima_vacacional becas comedor fonacot despensa servicios_publicos ///
>         pension_invalidez pension_familia otras_prestaciones sin_prestaciones, ///
>         i(folioviv foliohog numren) j(id_trabajo) string
 88.     *** Industry codes from SCIAN
.     gen ind1 = real(substr(scian1, 1, 2))
 89.     gen ind2 = real(substr(scian2, 1, 2))
 90.     label_scian
 91.     rename htrab1 hours1
 92.     rename htrab2 hours2
 93.     label variable hours1 "weekly hours – main job"
 94.     label variable hours2 "weekly hours – secondary job"
 95.     *** Recode benefits to 0/1 binaries (single source of truth in helper)
.     recode_benefit_indicators
 96.     *** Subordinate / independent / personnel / paid / contract → 0/1
.     foreach base in subor indep personal pago contrato tipocontr {
 97.         foreach j in 1 2 {
 98.             cap destring `base'`j', replace
 99.             cap recode `base'`j' (1=1)(2=0)(3=0)(else=0)
100.         }
101.     }
102.     tempfile trab_`year'
103.     save `trab_`year''
104. 
.     *** ---- Gastospersona (personal expenditure aggregates) ---------
.     use "../../data/source/enigh/gastospersona`year'.dta", clear
105.     collapse (sum) gasto_tri gas_nm_tri, by(folioviv foliohog numren)
106.     rename gasto_tri  gaspers_tri
107.     rename gas_nm_tri gaspers_ntri
108.     label variable gaspers_tri  "trimestral monetary expenditure (person)"
109.     label variable gaspers_ntri "trimestral non-monetary expenditure (person)"
110.     tempfile gpers_`year'
111.     save `gpers_`year''
112. 
.     *** ---- Ingresos (income panel) — reshape to person × month ----
.     use "../../data/source/enigh/ingresos`year'.dta", clear
113.     classify_clave
114.     drop if missing(clave_group) | clave_group == ""
115.     *** ENIGH ingresos has 6 (slot, amount, month) tuples per record:
.     *** ing_1…ing_6 are amounts; mes_1…mes_6 are calendar months ("01"–"12").
.     *** Reshape so each row is one (person × clave × slot).
.     reshape long ing_ mes_, i(folioviv foliohog numren clave) j(slot)
116.     *** Normalize the month string and drop empty slots.
.     cap confirm string variable mes_
117.     if _rc {
118.         tostring mes_, replace force
119.     }
120.     replace mes_ = trim(mes_)
121.     drop if missing(mes_) | mes_ == ""
122.     gen byte month = real(mes_)
123.     drop if missing(month) | month < 1 | month > 12
124.     *** Aggregate to (person × clave_group × calendar-month).
.     collapse (sum) ing_nom = ing_, ///
>              by(folioviv foliohog numren clave_group month)
125.     *** Pivot wide so each clave_group becomes its own nominal column.
.     reshape wide ing_nom, ///
>              i(folioviv foliohog numren month) j(clave_group) string
126.     *** Standardize column names: ing_nom<group> → ing_<group>_nom.
.     foreach grp in wages non_wage_income gov_transfers rentas fin_capital ///
>                    negocio ventas other {
127.         cap rename ing_nom`grp' ing_`grp'_nom
128.         cap confirm variable ing_`grp'_nom
129.         if _rc {
130.             gen double ing_`grp'_nom = .
131.         }
132.         replace ing_`grp'_nom = 0 if missing(ing_`grp'_nom)
133.         label variable ing_`grp'_nom "nominal monthly `grp' income (pesos)"
134.     }
135.     tempfile inc_`year'
136.     save `inc_`year''
137. 
.     *** ---- Merge all per-year pieces -------------------------------
.     use `inc_`year'', clear
138.     merge m:1 folioviv foliohog numren using `pop_`year''
139.     drop _merge
140.     merge m:1 folioviv foliohog numren using `trab_`year''
141.     drop _merge
142.     merge m:1 folioviv foliohog numren using `gpers_`year''
143.     drop _merge
144.     merge m:1 folioviv using `viv_`year''
145.     drop _merge
146.     merge m:1 folioviv using `hog_`year''
147.     drop _merge
148. 
.     gen year = `year'
149.     order folioviv foliohog numren year month
150. 
.     tempfile yr_`year'
151.     save `yr_`year''
152.     local tempfiles "`tempfiles' `yr_`year''"
153. }

