. cap program drop classify_clave

. program define classify_clave
  1.     *** Generates clave_group from clave (P001-P108) following the project
.     *** classification used in enigh-indlevel-year.R. Categories:
.     ***   wages, non_wage_income, gov_transfers, rentas, fin_capital,
.     ***   negocio, ventas, other.
.     cap drop clave_group
  2.     gen str20 clave_group = ""
  3.     replace clave_group = "wages"             if inlist(clave, "P001","P002","P011","P018","P019","P067")
  4.     replace clave_group = "non_wage_income"   if inlist(clave, "P003","P004","P005","P006","P007","P008")
  5.     replace clave_group = "non_wage_income"   if inlist(clave, "P009","P014","P015","P016")
  6.     replace clave_group = "gov_transfers"     if inlist(clave, "P032","P033","P038","P040","P042","P043","P044","P045")
  7.     replace clave_group = "gov_transfers"     if inlist(clave, "P046","P047","P048","P101","P102","P103","P104","P105")
  8.     replace clave_group = "gov_transfers"     if inlist(clave, "P106","P107","P108")
  9.     replace clave_group = "rentas"            if inlist(clave, "P023","P024","P025")
 10.     replace clave_group = "fin_capital"       if inlist(clave, "P026","P027","P028","P029","P030","P031","P050","P052")
 11.     replace clave_group = "fin_capital"       if inlist(clave, "P053","P064","P065","P066")
 12.     replace clave_group = "negocio"           if inlist(clave, "P068","P069","P070","P071","P072","P073","P074","P075")
 13.     replace clave_group = "negocio"           if inlist(clave, "P076","P077","P078","P079","P080","P081")
 14.     replace clave_group = "ventas"            if inlist(clave, "P054","P055","P056","P059","P060","P061","P062","P063")
 15.     replace clave_group = "other"             if inlist(clave, "P012","P013","P020","P021","P022","P034","P035","P036")
 16.     replace clave_group = "other"             if inlist(clave, "P037","P039","P041","P049","P051","P057","P058")
 17. end

