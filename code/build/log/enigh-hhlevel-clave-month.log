. *************************************************
. *********** Gastos Capitulo Mapping **************
. *************************************************
. 
. *** ENIGH expenditure clave codes are 6-digit strings. The first 2 digits
. *** identify the capítulo (COICOP-style), e.g. "01" = food, "11" = restaurants.
. *** T-codes (T901..T916) are pre-aggregated — drop them to avoid double-counting.
. ***
. *** Capitulo groups (first 2 digits of clave):
. ***   01 = Alimentos y bebidas no alcohólicas
. ***   02 = Bebidas alcohólicas y tabaco
. ***   03 = Prendas de vestir y calzado
. ***   04 = Vivienda, agua, electricidad, gas y otros combustibles
. ***   05 = Mobiliario, equipo y mantenimiento de la casa
. ***   06 = Salud
. ***   07 = Transporte
. ***   08 = Comunicaciones
. ***   09 = Recreación y cultura
. ***   10 = Educación
. ***   11 = Restaurantes y servicios de alojamiento
. ***   12 = Cuidados personales y otros bienes y servicios
. ***   13 = Servicios diversos
. ***   17 = Erogaciones financieras y de capital (extra: not consumption)
. ***   18 = Otros productos / vacíos (catch-all in 2024 catalog)
. 
. cap program drop classify_gasto_clave

. program define classify_gasto_clave
  1.     *** Adds two columns to the gastos data in memory:
.     ***   capitulo     — 2-digit string capítulo code
.     ***   gasto_group  — coarse custom group (food / durables / services / ...)
.     cap drop capitulo
  2.     cap drop gasto_group
  3.     *** Drop pre-aggregated T-codes so we don't double-count.
.     drop if substr(clave, 1, 1) == "T"
  4.     gen str2 capitulo = substr(clave, 1, 2)
  5.     gen str20 gasto_group = ""
  6.     replace gasto_group = "food"          if capitulo == "01"
  7.     replace gasto_group = "alcohol_tobac" if capitulo == "02"
  8.     replace gasto_group = "clothing"      if capitulo == "03"
  9.     replace gasto_group = "housing"       if capitulo == "04"
 10.     replace gasto_group = "durables"      if capitulo == "05"
 11.     replace gasto_group = "health"        if capitulo == "06"
 12.     replace gasto_group = "transport"     if capitulo == "07"
 13.     replace gasto_group = "comms"         if capitulo == "08"
 14.     replace gasto_group = "recreation"    if capitulo == "09"
 15.     replace gasto_group = "education"     if capitulo == "10"
 16.     replace gasto_group = "restaurants"   if capitulo == "11"
 17.     replace gasto_group = "personal"      if capitulo == "12"
 18.     replace gasto_group = "services"      if capitulo == "13"
 19.     replace gasto_group = "financial"     if capitulo == "17"
 20.     replace gasto_group = "other"         if gasto_group == ""
 21. end

. 
. *************************************************
. ********* HH × year aggregation of gastos ********
. *************************************************
. 
. *** Loads gastoshogar`yr'.dta and returns a tempfile path (in the global
. *** $hh_gastos_tf) holding one row per (folioviv, foliohog) for survey year
. *** `yr', with columns:
. ***   year                      — the survey wave
. ***   gas_total_nom             — sum of gasto_tri (nominal trimestral pesos)
. ***   gas_total_nm_nom          — sum of gas_nm_tri (non-monetary trimestral)
. ***   gas_<grp>_nom             — sum by custom group (food, durables, ...)
. ***   gas_cap<NN>_nom           — sum by capítulo NN ∈ {01,..,18}
. ***   <plus _real counterparts deflated by Aug-yr INPC>
. 
. cap program drop aggregate_gastos_hh_year

. program define aggregate_gastos_hh_year
  1.     args yr defl_tf target
  2.     preserve
  3.     use "../../data/source/enigh/gastoshogar`yr'.dta", clear
  4.     cap destring gasto_tri,    replace
  5.     cap destring gas_nm_tri,   replace
  6.     classify_gasto_clave
  7.     *** Stash the raw clave-level rows so we can build sub-aggregates.
.     tempfile _raw _grp _cap
  8.     save `_raw', replace
  9.     *** (HH × gasto_group) wide table.
.     use `_raw', clear
 10.     collapse (sum) gasto_tri gas_nm_tri, ///
>         by(folioviv foliohog gasto_group)
 11.     reshape wide gasto_tri gas_nm_tri, ///
>         i(folioviv foliohog) j(gasto_group) string
 12.     save `_grp', replace
 13.     *** (HH × capitulo) wide table.
.     use `_raw', clear
 14.     collapse (sum) gasto_tri gas_nm_tri, ///
>         by(folioviv foliohog capitulo)
 15.     reshape wide gasto_tri gas_nm_tri, ///
>         i(folioviv foliohog) j(capitulo) string
 16.     save `_cap', replace
 17.     *** HH total.
.     use `_raw', clear
 18.     collapse (sum) gas_total_nom = gasto_tri ///
>                    gas_total_nm_nom = gas_nm_tri, ///
>         by(folioviv foliohog)
 19.     *** Merge group + capitulo aggregates.
.     merge 1:1 folioviv foliohog using `_grp'
 20.     drop _merge
 21.     merge 1:1 folioviv foliohog using `_cap'
 22.     drop _merge
 23.     *** Standardize column names: gasto_tri<grp> -> gas_<grp>_nom etc.
.     foreach grp in food alcohol_tobac clothing housing durables health ///
>                    transport comms recreation education restaurants ///
>                    personal services financial other {
 24.         cap rename gasto_tri`grp'  gas_`grp'_nom
 25.         cap rename gas_nm_tri`grp' gas_`grp'_nm_nom
 26.         cap confirm variable gas_`grp'_nom
 27.         if _rc gen double gas_`grp'_nom = 0
 28.         cap confirm variable gas_`grp'_nm_nom
 29.         if _rc gen double gas_`grp'_nm_nom = 0
 30.         replace gas_`grp'_nom    = 0 if missing(gas_`grp'_nom)
 31.         replace gas_`grp'_nm_nom = 0 if missing(gas_`grp'_nm_nom)
 32.         label variable gas_`grp'_nom    "nominal HH expenditure: `grp' (trimestral pesos)"
 33.         label variable gas_`grp'_nm_nom "nominal HH non-monetary expenditure: `grp' (trimestral pesos)"
 34.     }
 35.     foreach cap_n in 01 02 03 04 05 06 07 08 09 10 11 12 13 17 18 {
 36.         cap rename gasto_tri`cap_n'  gas_cap`cap_n'_nom
 37.         cap rename gas_nm_tri`cap_n' gas_cap`cap_n'_nm_nom
 38.         cap confirm variable gas_cap`cap_n'_nom
 39.         if _rc gen double gas_cap`cap_n'_nom = 0
 40.         cap confirm variable gas_cap`cap_n'_nm_nom
 41.         if _rc gen double gas_cap`cap_n'_nm_nom = 0
 42.         replace gas_cap`cap_n'_nom    = 0 if missing(gas_cap`cap_n'_nom)
 43.         replace gas_cap`cap_n'_nm_nom = 0 if missing(gas_cap`cap_n'_nm_nom)
 44.         label variable gas_cap`cap_n'_nom    "nominal HH expenditure: capítulo `cap_n' (trimestral pesos)"
 45.         label variable gas_cap`cap_n'_nm_nom "nominal HH non-monetary expenditure: capítulo `cap_n' (trimestral pesos)"
 46.     }
 47.     *** Deflate by August INPC of `yr'. Save current (HH-aggregated) data,
.     *** read the deflator file to extract the scalar, then reload the data.
.     tempfile _hh_pre_defl
 48.     save `_hh_pre_defl', replace
 49.     use "`defl_tf'", clear
 50.     keep if year == `yr' & month == 8
 51.     quietly: summarize deflator
 52.     local ago_def = r(mean)
 53.     use `_hh_pre_defl', clear
 54.     if `ago_def' == 0 | missing(`ago_def') local ago_def = 1
 55.     foreach v of varlist gas_*_nom {
 56.         local r = subinstr("`v'", "_nom", "_real", 1)
 57.         gen double `r' = `v' / `ago_def'
 58.         local lab : variable label `v'
 59.         label variable `r' "real (Aug-2024) `lab'"
 60.     }
 61.     gen year = `yr'
 62.     save "`target'", replace
 63.     restore
 64. end

. 
. 
. local YEARS 2016 2018 2020 2022 2024

. 
. *************************************************
. **************** INPC Deflators ******************
. *************************************************
. 
. tempfile defl_tf

. load_deflators_to "`defl_tf'"
