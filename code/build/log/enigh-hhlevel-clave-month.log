. *************************************************
. *************** Build per-year ******************
. *************************************************
. 
. tempfile clave_panel_all

. local first_iter = 1

. 
. foreach yr of local YEARS {
  2.     display _n "Processing gastoshogar `yr' …"
  3. 
.     *** Load gastoshogar and add capitulo + gasto_group columns.
.     use "../../data/source/enigh/gastoshogar`yr'.dta", clear
  4.     cap destring gasto_tri,  replace
  5.     cap destring gas_nm_tri, replace
  6.     classify_gasto_clave
  7. 
.     *** Extract calendar month from mes_dia ("MMDD"; missing == "0000").
.     cap confirm string variable mes_dia
  8.     if _rc tostring mes_dia, replace
  9.     gen byte month = real(substr(mes_dia, 1, 2))
 10.     drop if missing(month) | month < 1 | month > 12
 11. 
.     *** Aggregate to (HH × clave × month). Each trimestral observation is
.     *** spread across the 3 reference months evenly when mes_dia is valid.
.     gen double gas_nom    = gasto_tri  / 3
 12.     gen double gas_nm_nom = gas_nm_tri / 3
 13. 
.     collapse (sum) gas_nom gas_nm_nom ///
>              (firstnm) capitulo gasto_group, ///
>              by(folioviv foliohog clave month)
 14. 
.     *** Deflate by Aug-`yr' INPC.
.     quietly {
 15.         preserve
 16.         use "`defl_tf'", clear
 17.         keep if year == `yr' & month == 8
 18.         summarize deflator
 19.         local ago_def = r(mean)
 20.         restore
 21.     }
 22.     if `ago_def' == 0 | missing(`ago_def') local ago_def = 1
 23.     gen double gas_real    = gas_nom    / `ago_def'
 24.     gen double gas_nm_real = gas_nm_nom / `ago_def'
 25.     gen double deflator    = `ago_def'
 26. 
.     *** Build calendar time = first day of month in survey year.
.     gen mes_str = string(month, "%02.0f")
 27.     gen time    = date(string(`yr') + "-" + mes_str, "YM")
 28.     format time %td
 29.     drop mes_str
 30.     gen year = `yr'
 31. 
.     *** Merge HH-level treatment + survey design from concentradohogar.
.     tempfile gh_panel
 32.     save `gh_panel', replace
 33.     use "../../data/source/enigh/concentradohogar`yr'.dta", clear
 34.     cap confirm string variable ubica_geo
 35.     if _rc tostring ubica_geo, replace
 36.     keep folioviv foliohog ubica_geo factor smg upm est_dis
 37.     cap destring factor smg, replace
 38.     duplicates drop folioviv foliohog, force
 39.     clean_ubica_geo `yr'
 40.     apply_state_region
 41.     apply_zlfn
 42.     tempfile hh_meta
 43.     save `hh_meta', replace
 44. 
.     use `gh_panel', clear
 45.     merge m:1 folioviv foliohog using `hh_meta'
 46.     drop if _merge == 2
 47.     drop _merge
 48. 
.     if `first_iter' {
 49.         save `clave_panel_all', replace
 50.         local first_iter = 0
 51.     }
 52.     else {
 53.         append using `clave_panel_all', force
 54.         save `clave_panel_all', replace
 55.     }
 56. }

