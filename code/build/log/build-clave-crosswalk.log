. *************************************************
. **** Apply seed rules (first-match-wins) *********
. *************************************************
. 
. preserve

. qui import delimited "clave_subgroups_seed.csv", ///
>     stringcols(_all) varnames(1) clear

. local nrules = _N

. forval r = 1/`nrules' {
  2.     local _s`r'  = clave_start[`r']
  3.     local _e`r'  = clave_end[`r']
  4.     local _c`r'  = capitulo_norm[`r']
  5.     local _sg`r' = subgroup[`r']
  6.     local _sl`r' = subgroup_label[`r']
  7. }

. restore

. 
. gen str10 capitulo_norm  = ""
(1,771 missing values generated)

. gen str40 subgroup       = ""
(1,771 missing values generated)

. gen str80 subgroup_label = ""
(1,771 missing values generated)

. 
. forval r = 1/`nrules' {
  2.     qui replace capitulo_norm  = "`_c`r''"  ///
>         if missing(subgroup) & "`_s`r''" <= clave & clave <= "`_e`r''"
  3.     qui replace subgroup_label = "`_sl`r''" ///
>         if missing(subgroup) & "`_s`r''" <= clave & clave <= "`_e`r''"
  4.     qui replace subgroup       = "`_sg`r''" ///
>         if missing(subgroup) & "`_s`r''" <= clave & clave <= "`_e`r''"
  5. }

. 
. *** Coverage gate.
. cap assert !missing(subgroup)

. if _rc {
.     di as error "build-clave-crosswalk: unmatched clave(s); " ///
>                 "extend code/build/clave_subgroups_seed.csv"
.     list clave if missing(subgroup), clean noobs
.     exit 9
. }

