.     *** Get August `yr' deflator (HH aggregates from concentradohogar are
.     *** quarterly nominal; treat as Aug-`yr' nominal for deflation).
.     quietly: preserve
 22.     use "`defl_tf'", clear
 23.     keep if year == `yr' & month == 8
 24.     quietly: summarize deflator
 25.     local ago_def = r(mean)
 26.     quietly: restore
 27.     if `ago_def' == 0 | missing(`ago_def') local ago_def = 1
 28. 
.     foreach v in ing_cor_nom ing_mon_hh_nom ing_no_mon_nom gas_nm_pa_nom ///
>                  ictpch_nom gas_food_nom gas_nonfood_nom erogac_tot {
 29.         local r = subinstr("`v'", "_nom", "", .)
 30.         gen double `r'_real = `v' / `ago_def'
 31.     }
 32. 
.     gen year = `yr'
 33.     if `first_iter' {
 34.         save `hh_exp_all', replace
 35.         local first_iter = 0
 36.     }
 37.     else {
 38.         append using `hh_exp_all', force
 39.         save `hh_exp_all', replace
 40.     }
 41. }
