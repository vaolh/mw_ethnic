. tempfile coneval_all

. local first_iter = 1

. foreach yr of local YEARS {
  2.     capture confirm file "../../data/source/coneval/pobreza`yr'.dta"
  3.     if _rc {
  4.         display as error "CONEVAL file missing for `yr', skipping."
  5.         continue
  6.     }
  7.     preserve
  8.     use "../../data/source/coneval/pobreza`yr'.dta", clear
  9.     rename _all, lower
 10.     keep if pea == 1 | pea == 2
 11.     *** Get August INPC deflator for `yr'.
.     quietly: use "`defl_tf'", clear
 12.     keep if year == `yr' & month == 8
 13.     quietly: summarize deflator
 14.     local ago_def = r(mean)
 15.     if `ago_def' == 0 | missing(`ago_def') local ago_def = 1
 16.     use "../../data/source/coneval/pobreza`yr'.dta", clear
 17.     rename _all, lower
 18.     keep if pea == 1 | pea == 2
 19.     cap replace hli = 2 if missing(hli)
 20.     cap gen byte informal = (pea == 1 & ss_dir == 0)
 21.     foreach v in ictpc ict nomon reg_esp pago_esp {
 22.         cap confirm variable `v'
 23.         if _rc == 0 {
 24.             cap gen double `v'_nom = `v'
 25.             replace `v' = `v' / `ago_def'
 26.         }
 27.     }
 28.     *** Drop CONEVAL income aggregates that we already compute from ENIGH.
.     foreach v in ing_mon ing_lab ing_ren ing_tra {
 29.         cap drop `v'
 30.     }
 31.     gen year = `yr'
 32.     *** Restrict to canonical CONEVAL columns; tolerate missing ones.
.     local cv_keep folioviv foliohog numren year ///
>          hli hlio hlm informal pea ss_dir ///
>          ictpc ict nomon reg_esp pago_esp ///
>          ictpc_nom ict_nom nomon_nom ///
>          clas_emp tam_emp sector
 33.     local cv_present ""
 34.     foreach v of local cv_keep {
 35.         cap confirm variable `v'
 36.         if _rc == 0 local cv_present "`cv_present' `v'"
 37.     }
 38.     keep `cv_present'
 39.     cap quietly: replace folioviv = string(real(folioviv), "%010.0f") if !missing(folioviv)
 40.     if `first_iter' {
 41.         save `coneval_all', replace
 42.         local first_iter = 0
 43.     }
 44.     else {
 45.         append using `coneval_all', force
 46.         save `coneval_all', replace
