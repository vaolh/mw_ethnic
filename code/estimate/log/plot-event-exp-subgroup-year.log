. cap prog drop savecoeffs

. program define savecoeffs
  1.     syntax namelist, CVARname(string) INTERACTION_pattern(string) SAVEdir(
> string)
  2. 
.     *** Get coefficient names from the first stored estimate.
.     local first : word 1 of `namelist'
  3.     qui estimates restore `first'
  4.     local allcoefs : colnames e(b)
  5. 
.     *** Filter to those containing both the heterogeneity variable name and
.     *** the interaction-pattern token (e.g. "1.zlfn#1.post").
.     local intcoefs
  6.     foreach c of local allcoefs {
  7.         if strpos("`c'", "`interaction_pattern'") > 0 & strpos("`c'", "`cv
> arname'") > 0 {
  8.             local intcoefs `intcoefs' `c'
  9.         }
 10.     }
 11. 
.     local ncoefs : word count `intcoefs'
 12.     if `ncoefs' == 0 {
 13.         di as error "savecoeffs: no interaction coefficients found for `cv
> arname' / `interaction_pattern'"
 14.         exit 198
 15.     }
 16. 
.     *** Capture value labels BEFORE preserve (preserve restores data state bu
> t
.     *** value-label associations are lost across clear).
.     forval i = 1/`ncoefs' {
 17.         local thiscoef : word `i' of `intcoefs'
 18.         local rc = regexm("`thiscoef'", "^([0-9]+)[bo]?\.")
 19.         local numpart = regexs(1)
 20.         local lbl`i' : label (`cvarname') `numpart'
 21.         local id`i' = `numpart'
 22.     }
 23. 
.     preserve
 24.     clear
 25.     qui set obs `ncoefs'
 26.     gen str80 coefname           = ""
 27.     gen int   `cvarname'_id      = .
 28.     gen str80 `cvarname'_label   = ""
 29. 
.     forval i = 1/`ncoefs' {
 30.         local thiscoef : word `i' of `intcoefs'
 31.         qui replace coefname           = "`thiscoef'" in `i'
 32.         qui replace `cvarname'_id      = `id`i''      in `i'
 33.         qui replace `cvarname'_label   = "`lbl`i''"   in `i'
 34.     }
 35. 
.     foreach estnm of local namelist {
 36.         qui estimates restore `estnm'
 37.         tempname bvec vvec
 38.         matrix `bvec' = e(b)
 39.         matrix `vvec' = vecdiag(e(V))
 40. 
.         gen double b_`estnm'  = .
 41.         gen double se_`estnm' = .
 42.         gen double N_`estnm'  = e(N)
 43. 
.         forval i = 1/`ncoefs' {
 44.             local thiscoef : word `i' of `intcoefs'
 45.             local colidx = colnumb(`bvec', "`thiscoef'")
 46.             if `colidx' != . {
 47.                 qui replace b_`estnm'  = `bvec'[1, `colidx']        in `i'
 48.                 qui replace se_`estnm' = sqrt(`vvec'[1, `colidx']) in `i'
 49.             }
 50.         }
 51.     }
 52. 
.     order `cvarname'_id `cvarname'_label
 53.     drop coefname
 54.     sort `cvarname'_id
 55. 
.     cap mkdir "`savedir'"
 56.     qui save             "`savedir'/coefficients_`cvarname'.dta", replace
 57.     qui export delimited "`savedir'/coefficients_`cvarname'.csv", replace
 58.     di as text "savecoeffs: wrote coefficients_`cvarname'.{dta,csv} to `sa
> vedir'"
 59.     restore
 60. end

. 
