. **************** yearcoefs **********************
. *************************************************
. 
. cap prog drop yearcoefs

. program define yearcoefs
  1.     syntax, EQname(string)
  2.     qui estimates restore `eqname'
  3.     cap matrix drop __year_b
  4.     cap matrix drop __year_se
  5.     matrix __year_b  = J(1, 5, 0)
  6.     matrix __year_se = J(1, 5, 0)
  7.     matrix __year_b[1, 1]  = _b[1.zlfn#2016.year]
  8.     matrix __year_b[1, 3]  = _b[1.zlfn#2020.year]
  9.     matrix __year_b[1, 4]  = _b[1.zlfn#2022.year]
 10.     matrix __year_b[1, 5]  = _b[1.zlfn#2024.year]
 11.     matrix __year_se[1, 1] = _se[1.zlfn#2016.year]
 12.     matrix __year_se[1, 3] = _se[1.zlfn#2020.year]
 13.     matrix __year_se[1, 4] = _se[1.zlfn#2022.year]
 14.     matrix __year_se[1, 5] = _se[1.zlfn#2024.year]
 15.     matrix colnames __year_b  = c2016 c2018 c2020 c2022 c2024
 16.     matrix colnames __year_se = c2016 c2018 c2020 c2022 c2024
 17. end

. 
