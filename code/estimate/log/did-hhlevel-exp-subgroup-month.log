. **** DiD loop ************************************
. *************************************************
. 
. estimates clear

. 
. local OUTCOMES lngas share

. 
. foreach c of local CAPS {
  2.     if "`c'" == "17" | "`c'" == "18" continue
  3.     local CSUBS `"`SUB_`c''"'
  4.     local k = wordcount("`CSUBS'")
  5.     if `k' == 0 continue
  6. 
.     foreach y of local OUTCOMES {
  7.         estimates clear
  8.         local cols ""
  9. 
.         foreach s of local CSUBS {
 10.             local yvar = cond("`y'" == "lngas", "lngas_`s'_real", "share_`
> s'")
 11.             cap confirm variable `yvar'
 12.             if _rc {
 13.                 di as text "skipping `yvar' (not in memory)"
 14.                 continue
 15.             }
 16. 
.             reghdfe `yvar' i.zlfn##i.post $controls, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 17.             eststo `s'_all
 18.             estadd local stratum "All"
 19. 
.             reghdfe `yvar' i.zlfn##i.post $controls if hli_hh == 0, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 20.             eststo `s'_hli0
 21.             estadd local stratum "HLI=0"
 22. 
.             reghdfe `yvar' i.zlfn##i.post $controls if indig_hh == 0, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 23.             eststo `s'_ind0
 24.             estadd local stratum "Indig=0"
 25. 
.             cap reghdfe `yvar' i.zlfn##i.post $controls if hli_hh == 1, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 26.             if !_rc {
 27.                 eststo `s'_hli1
 28.                 estadd local stratum "HLI=1"
 29.             }
 30. 
.             cap reghdfe `yvar' i.zlfn##i.post $controls if indig_hh == 1, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 31.             if !_rc {
 32.                 eststo `s'_ind1
 33.                 estadd local stratum "Indig=1"
 34.             }
 35. 
.             local cols `cols' `s'_all `s'_hli0 `s'_ind0 `s'_hli1 `s'_ind1
 36.         }
 37. 
.         if "`cols'" == "" continue
 38. 
.         local mg_labels ""
 39.         local mg_pattern ""
 40.         local col_mtitles ""
 41.         foreach s of local CSUBS {
 42.             local yvar = cond("`y'" == "lngas", "lngas_`s'_real", "share_`
> s'")
 43.             cap confirm variable `yvar'
 44.             if _rc continue
 45.             local mg_labels `"`mg_labels' "`s'""'
 46.             local mg_pattern `mg_pattern' 1 0 0 0 0
 47.             local col_mtitles `"`col_mtitles' "All" "HLI=0" "Indig=0" "HLI
> =1" "Indig=1""'
 48.         }
 49. 
.         esttab `cols' using "`TABDIR'did-exp-subgroup-`c'-`y'-month.tex", ///
>             replace label fragment booktabs ///
>             mgroups(`mg_labels', pattern(`mg_pattern') ///
>                     prefix(\multicolumn{5}{c}{) suffix(}) span ///
>                     erepeat(\cmidrule(lr){@span})) ///
>             mtitles(`col_mtitles') ///
>             nonumbers collabels(none) ///
>             cells(b(star fmt(%9.3f)) se(par fmt(%9.3f))) ///
>             starlevels(* 0.10 ** 0.05 *** 0.01) ///
>             keep(1.zlfn#1.post) ///
>             coeflabel(1.zlfn#1.post "ZLFN $\times$ Post") ///
>             stats(N, fmt(%11.0gc) label("Observations")) ///
>             nogaps
 50.         di as text "wrote did-exp-subgroup-`c'-`y'-month.tex (cap=`c', out
> come=`y', subgroups=`k')"
 51.     }
 52. }
