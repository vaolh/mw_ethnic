. cap prog drop savecoeffs

. program define savecoeffs
  1.     syntax namelist, CVARname(string) INTERACTION_pattern(string) SAVEdir(
> string)
  2. 
.     *** Get coefficient names from the first stored estimate.
.     local first : word 1 of `namelist'
  3.     qui estimates restore `first'
  4.     local allcoefs : colnames e(b)
  5. 
.     *** Filter to those containing both the heterogeneity variable name and
.     *** the interaction-pattern token (e.g. "1.zlfn#1.post").
.     local intcoefs
  6.     foreach c of local allcoefs {
  7.         if strpos("`c'", "`interaction_pattern'") > 0 & strpos("`c'", "`cv
> arname'") > 0 {
  8.             local intcoefs `intcoefs' `c'
  9.         }
 10.     }
 11. 
.     local ncoefs : word count `intcoefs'
 12.     if `ncoefs' == 0 {
 13.         di as error "savecoeffs: no interaction coefficients found for `cv
> arname' / `interaction_pattern'"
 14.         exit 198
 15.     }
 16. 
.     *** Capture value labels BEFORE preserve (preserve restores data state bu
> t
.     *** value-label associations are lost across clear).
.     forval i = 1/`ncoefs' {
 17.         local thiscoef : word `i' of `intcoefs'
 18.         local rc = regexm("`thiscoef'", "^([0-9]+)[bo]?\.")
 19.         local numpart = regexs(1)
 20.         local lbl`i' : label (`cvarname') `numpart'
 21.         local id`i' = `numpart'
 22.     }
 23. 
.     preserve
 24.     clear
 25.     qui set obs `ncoefs'
 26.     gen str80 coefname           = ""
 27.     gen int   `cvarname'_id      = .
 28.     gen str80 `cvarname'_label   = ""
 29. 
.     forval i = 1/`ncoefs' {
 30.         local thiscoef : word `i' of `intcoefs'
 31.         qui replace coefname           = "`thiscoef'" in `i'
 32.         qui replace `cvarname'_id      = `id`i''      in `i'
 33.         qui replace `cvarname'_label   = "`lbl`i''"   in `i'
 34.     }
 35. 
.     foreach estnm of local namelist {
 36.         qui estimates restore `estnm'
 37.         tempname bvec vvec
 38.         matrix `bvec' = e(b)
 39.         matrix `vvec' = vecdiag(e(V))
 40. 
.         gen double b_`estnm'  = .
 41.         gen double se_`estnm' = .
 42.         gen double N_`estnm'  = e(N)
 43. 
.         forval i = 1/`ncoefs' {
 44.             local thiscoef : word `i' of `intcoefs'
 45.             local colidx = colnumb(`bvec', "`thiscoef'")
 46.             if `colidx' != . {
 47.                 qui replace b_`estnm'  = `bvec'[1, `colidx']        in `i'
 48.                 qui replace se_`estnm' = sqrt(`vvec'[1, `colidx']) in `i'
 49.             }
 50.         }
 51.     }
 52. 
.     order `cvarname'_id `cvarname'_label
 53.     drop coefname
 54.     sort `cvarname'_id
 55. 
.     cap mkdir "`savedir'"
 56.     qui save             "`savedir'/coefficients_`cvarname'.dta", replace
 57.     qui export delimited "`savedir'/coefficients_`cvarname'.csv", replace
 58.     di as text "savecoeffs: wrote coefficients_`cvarname'.{dta,csv} to `sa
> vedir'"
 59.     restore
 60. end

. 
. do read-hhlevel-exp-subgroup-month.do

. *************************************************
. *** Read HH × Subgroup × Month Expenditure *******
. *************************************************
. 
. *** REPLICATION FILE: read-hhlevel-exp-subgroup-month.do
. *** STATA VERSION:    StataNow 19.5
. *** AUTHORS:          Matías Carrasco, Victor Ortega Le Hénanff
. *** DATE:             2026-05-10
. 
. *** Loads the long expenditure panel (one row per HH × clave × month) from
. *** code/build/enigh-hhlevel-exp-month.do, then collapses to the harmonized
. *** ~65-subgroup partition built by build-clave-crosswalk.py. Reshapes to
. *** wide format so each row is (HH × year × month) with one column per
. *** subgroup for both real-expenditure level (gas_<sub>_real) and share of
. *** household total (share_<sub>). Merges HH demographics + treatment from
. *** enigh-hhlevel-inc-month.dta.
. ***
. *** Output dataset in memory has, per (HH × year × month) row:
. ***   folioviv foliohog year month time                       (key)
. ***   gas_total_real lngas_total_real                          (totals)
. ***   gas_<sub>_real, lngas_<sub>_real, share_<sub>            (~65 × 3)
. ***   zlfn post treat_post ubica_geo factor smg                (treatment)
. ***   hli_hh indig_hh                                          (strata)
. ***   $controls = hh_size n_kids n_adults n_workers
. ***                mean_age mean_educ share_female
. ***
. *** Macros set on exit:
. ***   SUBGROUPS — space-separated list of all ~65 subgroup names
. ***   $controls — global of HH composition control vars
. ***
. *** Note: cap 17 (Q* claves = financial capital flows) is excluded from
. *** the consumption analysis to keep outcomes interpretable as expenditure.
. 
. *************************************************
. ****************** Load Data ********************
. *************************************************
. 
. use "../../data/clean/enigh/enigh-hhlevel-exp-month.dta", clear

. 
. *** Drop capital-flow rows (Q* / cap 17) — these are not consumption.
. drop if capitulo == "17"
(606 observations deleted)

. 
. *** Drop the placeholder "other_uncategorized" subgroup — empty-label codes
. *** that carry no substantive content.
. drop if subgroup == "other_uncategorized"
(49,612 observations deleted)

. 
. *************************************************
. **** Collapse claves -> subgroup × HH × month *****
. *************************************************
. 
. *** Sum within (HH, year, month, subgroup) — one row per HH-month-subgroup.
. collapse (sum) gas_real gas_nm_real ///
>          (firstnm) zlfn post treat_post ubica_geo factor smg upm est_dis ///
>                    state ent_name reg_num reg_name macro_num macro_name time,
>  ///
>          by(folioviv foliohog year month subgroup)

. 
. *************************************************
. **** Compute HH-month totals ********************
. *************************************************
. 
. *** Total real expenditure per (HH, month) — denominator for shares.
. bysort folioviv foliohog year month: egen double gas_total_real = total(gas_r
> eal)

. 
. *** Expenditure share within each (HH, month).
. gen double share = gas_real / gas_total_real
(12,956 missing values generated)

. replace share = 0 if missing(share)  // zero-total months → zero share
(12,956 real changes made)

. 
. *** Logged real outcome (log+1 to handle zero-spending subgroup-months).
. gen double lngas_real = ln(gas_real + 1)

. 
. *************************************************
. **** Reshape wide: one col per subgroup ********
. *************************************************
. 
. *** Build a sortable subgroup-string key (Stata reshape needs ASCII names).
. *** subgroup is already snake_case ASCII from the crosswalk.
. 
. keep folioviv foliohog year month time subgroup ///
>      gas_real lngas_real share ///
>      zlfn post treat_post ubica_geo factor smg upm est_dis ///
>      state ent_name reg_num reg_name macro_num macro_name ///
>      gas_total_real

. 
. reshape wide gas_real lngas_real share, ///
>         i(folioviv foliohog year month) j(subgroup) string
(j = alcohol bev_coffee_tea_cocoa bev_nonalc clothing_accessories clothing_foot
> wear clothing_kids clothing_men clothing_women comms_internet_tv comms_teleph
> ony durables_appliances durables_furniture durables_kitchenware durables_repa
> ir_mat durables_textiles edu_tuition food_baby food_cereals_bread food_condim
> ents food_dairy food_eggs food_fish_seafood food_fruits food_meat_beef food_m
> eat_other food_meat_pork food_meat_poultry food_oils_fats food_other_misc foo
> d_outside food_prepared food_sugars_sweets food_tubers food_vegetables health
> _consultations health_devices health_hospital health_insurance health_pharmac
> y household_cleaning housing_fuel housing_quotas housing_rent housing_repairs
>  housing_taxes housing_utilities insurance_nonhealth personal_goods personal_
> services rec_culture_media rec_electronics_av rec_photography rec_tourism rec
> _toys_sports services_events services_household services_other services_profe
> ssional tobacco transport_fuel transport_intercity transport_local transport_
> veh_buy transport_veh_maint)

Data                               Long   ->   Wide
-----------------------------------------------------------------------------
Number of observations       19,596,236   ->   1,336,614   
Number of variables                  24   ->   212         
j variable (64 values)         subgroup   ->   (dropped)
xij variables:
                               gas_real   ->   gas_realalcohol gas_realbev_coff
> ee_tea_cocoa ... gas_realtransport_veh_maint
                             lngas_real   ->   lngas_realalcohol lngas_realbev_
> coffee_tea_cocoa ... lngas_realtransport_veh_maint
