>     refcat(1.zlfn#1.post "\textit{Panel A: Covered Sectors}", nolabel)       
>   ///
>     keep(1.zlfn#1.post)                                                      
>   ///
>     coeflabel(1.zlfn#1.post "\hspace{1em}ZLFN $\times$ 2016--2024")          
