. *************************************************
. **** DiD loop ************************************
. *************************************************
. 
. estimates clear

. 
. *** Helper: run 5 stratified regressions for (outcome y, subgroup s) and
. *** store as `_<y>_<s>_{all,hli0,ind0,hli1,ind1}`.
. local OUTCOMES lngas share

. 
. foreach c of local CAPS {
  2.     *** Skip capitulos excluded from the substantive analysis.
.     if "`c'" == "17" | "`c'" == "18" continue
  3. 
.     *** Skip capitulos with no subgroups loaded into memory (defensive).
.     local CSUBS `"`SUB_`c''"'
  4.     local k = wordcount("`CSUBS'")
  5.     if `k' == 0 continue
  6. 
.     foreach y of local OUTCOMES {
  7.         estimates clear
  8.         local cols ""
  9.         local titles ""
 10. 
.         foreach s of local CSUBS {
 11.             local yvar = cond("`y'" == "lngas", "lngas_`s'_real", "share_`
> s'")
 12.             cap confirm variable `yvar'
 13.             if _rc {
 14.                 di as text "skipping `yvar' (not in memory)"
 15.                 continue
 16.             }
 17. 
.             *** All HH
.             reghdfe `yvar' i.zlfn##i.post $controls, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 18.             eststo `s'_all
 19.             estadd local stratum "All"
 20. 
.             *** hli_hh == 0
.             reghdfe `yvar' i.zlfn##i.post $controls if hli_hh == 0, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 21.             eststo `s'_hli0
 22.             estadd local stratum "HLI=0"
 23. 
.             *** indig_hh == 0
.             reghdfe `yvar' i.zlfn##i.post $controls if indig_hh == 0, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 24.             eststo `s'_ind0
 25.             estadd local stratum "Indig=0"
 26. 
.             *** hli_hh == 1
.             cap reghdfe `yvar' i.zlfn##i.post $controls if hli_hh == 1, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 27.             if !_rc {
 28.                 eststo `s'_hli1
 29.                 estadd local stratum "HLI=1"
 30.             }
 31. 
.             *** indig_hh == 1
.             cap reghdfe `yvar' i.zlfn##i.post $controls if indig_hh == 1, ///
>                 absorb(ubica_geo year) vce(cluster ubica_geo)
 32.             if !_rc {
 33.                 eststo `s'_ind1
 34.                 estadd local stratum "Indig=1"
 35.             }
 36. 
.             local cols `cols' `s'_all `s'_hli0 `s'_ind0 `s'_hli1 `s'_ind1
 37.             local titles `"`titles' "`s'"  "`s'"  "`s'"  "`s'"  "`s'""'
 38.         }
 39. 
.         *** Skip if no models produced.
.         if "`cols'" == "" continue
 40. 
.         *** Build mgroups labels (one per subgroup) and the per-col mtitles
.         *** (5 strata × k subgroups). mgroups spans 5 cols with subgroup name
> .
.         local mg_labels ""
 41.         local mg_pattern ""
 42.         local col_mtitles ""
 43.         foreach s of local CSUBS {
 44.             local yvar = cond("`y'" == "lngas", "lngas_`s'_real", "share_`
> s'")
 45.             cap confirm variable `yvar'
 46.             if _rc continue
 47.             local mg_labels `"`mg_labels' "`s'""'
 48.             local mg_pattern `mg_pattern' 1 0 0 0 0
 49.             local col_mtitles `"`col_mtitles' "All" "HLI=0" "Indig=0" "HLI
> =1" "Indig=1""'
 50.         }
 51. 
.         esttab `cols' using "`TABDIR'did-exp-subgroup-`c'-`y'-year.tex", ///
>             replace label fragment booktabs ///
>             mgroups(`mg_labels', pattern(`mg_pattern') ///
>                     prefix(\multicolumn{5}{c}{) suffix(}) span ///
>                     erepeat(\cmidrule(lr){@span})) ///
>             mtitles(`col_mtitles') ///
>             nonumbers collabels(none) ///
>             cells(b(star fmt(%9.3f)) se(par fmt(%9.3f))) ///
>             starlevels(* 0.10 ** 0.05 *** 0.01) ///
>             keep(1.zlfn#1.post) ///
>             coeflabel(1.zlfn#1.post "ZLFN $\times$ Post") ///
>             stats(N, fmt(%11.0gc) label("Observations")) ///
>             nogaps
 52.         di as text "wrote did-exp-subgroup-`c'-`y'-year.tex (cap=`c', outc
> ome=`y', subgroups=`k')"
 53.     }
 54. }
